#
# Apache / PHP / RokuPal
# Compatible with XAMPP Apache 2.4.58 (Windows) + PHP 8.0
# NOTE: Do not use <DirectoryMatch> here — invalid in .htaccess → HTTP 500.
#

# Protect code-like extensions from direct download.
<FilesMatch "\.(engine|inc|info|install|make|module|profile|test|po|sh|sql|theme|tpl|xtmpl)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
# FollowSymLinks may be disallowed on some hosts; +FollowSymLinks is typical for XAMPP.
Options +FollowSymLinks

ErrorDocument 404 index.php
DirectoryIndex index.php

# PHP flags (module name varies by XAMPP build)
<IfModule mod_php.c>
  php_value session.auto_start 0
  php_flag display_errors Off
  php_flag log_errors On
  php_value max_execution_time 120
  php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
  php_value session.auto_start 0
  php_flag display_errors Off
  php_flag log_errors On
  php_value max_execution_time 120
  php_value memory_limit 256M
</IfModule>
<IfModule php8_module>
  php_value session.auto_start 0
  php_flag display_errors Off
  php_flag log_errors On
  php_value max_execution_time 120
  php_value memory_limit 256M
</IfModule>
<IfModule php_module>
  php_value session.auto_start 0
  php_flag display_errors Off
  php_flag log_errors On
  php_value max_execution_time 120
  php_value memory_limit 256M
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault A1209600
  <FilesMatch "\.php$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block access to maintenance scripts over HTTP (use CLI instead).
  RewriteRule ^scripts/ - [F,L]

  # Block PHP execution under files / uploads.
  RewriteRule ^(sites/[^/]+/files|files|uploads)/.*\.(php|phtml|phar)$ - [F,L,NC]

  # Block hidden dotfiles except .well-known
  RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

  # Front controller
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !=/favicon.ico
  RewriteRule ^(.*)$ index.php?q=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-XSS-Protection "1; mode=block"
  # CSP: inline needed for D6-lineage admin JS; no unsafe-eval.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # CORP can break some font/CDN edge cases; keep same-origin for app pages.
  Header always set Cross-Origin-Resource-Policy "same-origin"
  RequestHeader unset Proxy
</IfModule>
