<?php
/**
 * @file
 * RokuPal Forum — phpBB/vB-style index + blocks (no extra modules).
 */

function rokupal_forum_enable() {
  if (function_exists('rokupal_forum_ensure_menu')) { rokupal_forum_ensure_menu(); }
  variable_del('rokupal_forum_structure_ready');
  if (function_exists('rokupal_forum_ensure_structure')) {
    rokupal_forum_ensure_structure();
  }
  elseif (function_exists('rokupal_forum_ensure')) {
    rokupal_forum_ensure();
  }
  if (function_exists('rokupal_forum_setup_blocks')) {
    rokupal_forum_setup_blocks();
  }
  variable_set('comment_forum_topic', 2);
  variable_set('node_options_forum_topic', array('status'));
  variable_del('rokupal_menu_sig');
  if (function_exists('menu_rebuild')) {
    menu_rebuild();
  }
  cache_clear_all();
}

function rokupal_forum_disable() {
  if (function_exists('menu_rebuild')) {
    menu_rebuild();
  }
  cache_clear_all();
}

function rokupal_forum_menu() {
  $items = array();
  // Specific paths first (before wildcard).
  $items['forum'] = array(
    'title' => 'Forums',
    'page callback' => 'rokupal_forum_page',
    'access arguments' => array('access content'),
    'type' => MENU_NORMAL_ITEM,
    'weight' => -15,
  );
  $items['forum/active'] = array(
    'title' => 'Active topics',
    'page callback' => 'rokupal_forum_active_page',
    'access arguments' => array('access content'),
    'type' => MENU_NORMAL_ITEM,
    'weight' => -14,
  );
  // Only numeric forum IDs — "active" must not match this.
  $items['forum/%rokupal_forum_tid'] = array(
    'title callback' => 'rokupal_forum_term_title',
    'title arguments' => array(1),
    'page callback' => 'rokupal_forum_term_page',
    'page arguments' => array(1),
    'access arguments' => array('access content'),
    'type' => MENU_CALLBACK,
  );
  $items['forum/manage'] = array(
    'title' => 'Manage forums',
    'page callback' => 'rokupal_forum_manage_page',
    'access arguments' => array('administer taxonomy'),
    'type' => MENU_LOCAL_TASK,
    'weight' => 5,
  );
  return $items;
}

/**
 * Menu load: only accept numeric term ids.
 */
function rokupal_forum_tid_load($arg) {
  if (!is_numeric($arg) || (int) $arg <= 0) {
    return FALSE;
  }
  $term = taxonomy_get_term((int) $arg);
  return $term ? $term : FALSE;
}

function rokupal_forum_load_term($tid) {
  $tid = (int) $tid;
  if ($tid <= 0) {
    return FALSE;
  }
  return taxonomy_get_term($tid);
}

function rokupal_forum_term_title($term) {
  if (is_object($term) && !empty($term->name)) {
    return $term->name;
  }
  if (is_numeric($term)) {
    $t = taxonomy_get_term((int) $term);
    return $t ? $t->name : t('Forum');
  }
  return t('Forum');
}

/**
 * Forum index — categories/forums table (vBulletin/phpBB style).
 */
function rokupal_forum_page() {
  if (function_exists('rokupal_forum_ensure_structure')) {
    rokupal_forum_ensure_structure();
  }
  $vid = variable_get('rokupal_forum_vid', 0);
  $header = array(t('Forum'), t('Topics'), t('Posts'), t('Last post'));
  $rows = array();
  if ($vid) {
    $result = db_query("SELECT tid, name, description FROM {term_data} WHERE vid = %d ORDER BY weight, name", $vid);
    while ($term = db_fetch_object($result)) {
      $stats = rokupal_forum_term_stats($term->tid);
      $last = $stats['last_nid']
        ? l(truncate_utf8($stats['last_title'], 40, TRUE, TRUE), 'node/' . $stats['last_nid']) . '<br /><span class="rp-muted">' . check_plain($stats['last_name']) . ' · ' . format_date($stats['last_time'], 'small') . '</span>'
        : '—';
      $rows[] = array(
        '<strong>' . l($term->name, 'forum/' . $term->tid) . '</strong>'
          . ($term->description ? '<div class="rp-muted">' . check_plain($term->description) . '</div>' : ''),
        (int) $stats['topics'],
        (int) $stats['posts'],
        $last,
      );
    }
  }
  if (!$rows) {
    $empty = t('No forums yet.');
    if (user_access('administer taxonomy')) {
      $empty .= ' ' . l(t('Add a forum category'), 'admin/content/taxonomy');
    }
    $rows[] = array(array('data' => $empty, 'colspan' => 4));
  }

  $toolbar = '<div class="forum-toolbar">';
  $toolbar .= l(t('Active topics'), 'forum/active');
  if (user_access('create forum_topic content')) {
    $toolbar .= ' · ' . l(t('New topic'), 'node/add/forum-topic', array('attributes' => array('class' => 'forum-button')));
  }
  if (user_access('administer taxonomy')) {
    $toolbar .= ' · ' . l(t('Manage forums'), 'forum/manage');
  }
  $toolbar .= '</div>';

  $board = rokupal_forum_board_stats();
  $stats_bar = '<div class="forum-stats-bar">'
    . t('Topics: @t · Posts: @p · Members: @m', array(
      '@t' => $board['topics'],
      '@p' => $board['posts'],
      '@m' => $board['members'],
    )) . '</div>';

  $output = '<div class="forum-vbulletin">';
  $output .= '<div class="forum-vbulletin-header">' . t('Forums') . '</div>';
  $output .= $toolbar . $stats_bar;
  $output .= theme('table', $header, $rows, array('class' => 'forum-table'));
  $output .= '</div>';
  return $output;
}

function rokupal_forum_term_page($tid) {
  $term = is_object($tid) ? $tid : taxonomy_get_term((int) $tid);
  if (!$term) {
    return drupal_not_found();
  }
  $header = array(t('Topic'), t('Author'), t('Replies'), t('Last post'));
  $sql = "SELECT n.nid, n.title, n.uid, u.name AS author,
      COALESCE(cs.comment_count, 0) AS comment_count,
      COALESCE(cs.last_comment_timestamp, n.created) AS last_time
    FROM {term_node} tn
    INNER JOIN {node} n ON n.nid = tn.nid
    INNER JOIN {users} u ON u.uid = n.uid
    LEFT JOIN {node_comment_statistics} cs ON cs.nid = n.nid
    WHERE tn.tid = %d AND n.type = 'forum_topic' AND n.status = 1
    ORDER BY n.sticky DESC, last_time DESC";
  $result = pager_query(db_rewrite_sql($sql, 'n', 'nid'), 25, 0, NULL, $term->tid);
  $rows = array();
  while ($row = db_fetch_object($result)) {
    $rows[] = array(
      l($row->title, 'node/' . $row->nid),
      theme('username', (object) array('uid' => $row->uid, 'name' => $row->author)),
      (int) $row->comment_count,
      format_date($row->last_time, 'small'),
    );
  }
  if (!$rows) {
    $rows[] = array(array('data' => t('No topics in this forum yet.'), 'colspan' => 4));
  }
  $toolbar = '<div class="forum-toolbar">' . l(t('« All forums'), 'forum');
  if (user_access('create forum_topic content')) {
    $toolbar .= ' · ' . l(t('Post new topic'), 'node/add/forum-topic', array('query' => 'tid=' . (int) $term->tid, 'attributes' => array('class' => 'forum-button')));
  }
  $toolbar .= '</div>';
  $output = '<div class="forum-vbulletin">';
  $output .= '<div class="forum-vbulletin-header">' . check_plain($term->name) . '</div>';
  $output .= $toolbar;
  $output .= theme('table', $header, $rows, array('class' => 'forum-table'));
  $output .= theme('pager');
  $output .= '</div>';
  return $output;
}

function rokupal_forum_active_page() {
  drupal_set_title(t('Active topics'));
  $header = array(t('Topic'), t('Forum'), t('Replies'), t('Last post'));
  // Avoid subselects — db_rewrite_sql breaks them on SQLite.
  $sql = "SELECT n.nid, n.title, COALESCE(cs.comment_count, 0) AS comment_count,
      COALESCE(cs.last_comment_timestamp, n.created) AS last_time
    FROM {node} n
    LEFT JOIN {node_comment_statistics} cs ON cs.nid = n.nid
    WHERE n.type = 'forum_topic' AND n.status = 1
    ORDER BY last_time DESC";
  $result = pager_query(db_rewrite_sql($sql, 'n', 'nid'), 30);
  $rows = array();
  while ($row = db_fetch_object($result)) {
    $fname = '—';
    $tid = (int) db_result(db_query_range("SELECT tid FROM {term_node} WHERE nid = %d", 0, 1, $row->nid));
    if ($tid) {
      $term = taxonomy_get_term($tid);
      if ($term) {
        $fname = l($term->name, 'forum/' . $term->tid);
      }
    }
    $rows[] = array(
      l($row->title, 'node/' . $row->nid),
      $fname,
      (int) $row->comment_count,
      format_date($row->last_time, 'small'),
    );
  }
  if (!$rows) {
    $rows[] = array(array('data' => t('No topics yet.'), 'colspan' => 4));
  }
  return '<div class="forum-vbulletin">'
    . '<div class="forum-vbulletin-header">' . t('Active topics') . '</div>'
    . '<div class="forum-toolbar">' . l(t('« All forums'), 'forum') . '</div>'
    . theme('table', $header, $rows, array('class' => 'forum-table'))
    . theme('pager') . '</div>';
}

function rokupal_forum_term_stats($tid) {
  $stats = array('topics' => 0, 'posts' => 0, 'last_nid' => 0, 'last_title' => '', 'last_time' => 0, 'last_name' => '');
  $tid = (int) $tid;
  $stats['topics'] = (int) db_result(db_query(
    "SELECT COUNT(DISTINCT n.nid) FROM {term_node} tn INNER JOIN {node} n ON n.nid = tn.nid WHERE tn.tid = %d AND n.type = 'forum_topic' AND n.status = 1",
    $tid
  ));
  $stats['posts'] = $stats['topics'] + (int) db_result(db_query(
    "SELECT COALESCE(SUM(cs.comment_count), 0) FROM {term_node} tn
     INNER JOIN {node} n ON n.nid = tn.nid
     LEFT JOIN {node_comment_statistics} cs ON cs.nid = n.nid
     WHERE tn.tid = %d AND n.type = 'forum_topic' AND n.status = 1",
    $tid
  ));
  $last = db_fetch_object(db_query(
    "SELECT n.nid, n.title, u.name, COALESCE(cs.last_comment_timestamp, n.created) AS last_time
     FROM {term_node} tn INNER JOIN {node} n ON n.nid = tn.nid
     INNER JOIN {users} u ON u.uid = n.uid
     LEFT JOIN {node_comment_statistics} cs ON cs.nid = n.nid
     WHERE tn.tid = %d AND n.type = 'forum_topic' AND n.status = 1
     ORDER BY last_time DESC LIMIT 1",
    $tid
  ));
  if ($last) {
    $stats['last_nid'] = $last->nid;
    $stats['last_title'] = $last->title;
    $stats['last_time'] = $last->last_time;
    $stats['last_name'] = $last->name;
  }
  return $stats;
}

function rokupal_forum_board_stats() {
  $topics = (int) db_result(db_query("SELECT COUNT(*) FROM {node} WHERE type = 'forum_topic' AND status = 1"));
  $replies = (int) db_result(db_query("SELECT COALESCE(SUM(cs.comment_count), 0) FROM {node} n LEFT JOIN {node_comment_statistics} cs ON cs.nid = n.nid WHERE n.type = 'forum_topic' AND n.status = 1"));
  $members = (int) db_result(db_query("SELECT COUNT(*) FROM {users} WHERE uid > 0 AND status = 1"));
  return array('topics' => $topics, 'posts' => $topics + $replies, 'members' => $members);
}

function rokupal_forum_block($op = 'list', $delta = 0) {
  switch ($op) {
    case 'list':
      return array(
        'recent' => array('cache' => BLOCK_CACHE_GLOBAL, 'info' => t('Forum: recent topics')),
        'active' => array('cache' => BLOCK_CACHE_GLOBAL, 'info' => t('Forum: active topics')),
        'stats' => array('cache' => BLOCK_CACHE_GLOBAL, 'info' => t('Forum: board statistics')),
        'forums' => array('cache' => BLOCK_CACHE_GLOBAL, 'info' => t('Forum: forum list')),
        'new_topic' => array('cache' => BLOCK_CACHE_PER_ROLE, 'info' => t('Forum: post new topic')),
        'online' => array('cache' => BLOCK_CACHE_GLOBAL, 'info' => t('Forum: who is online')),
      );
    case 'view':
      switch ($delta) {
        case 'online':
          return array('subject' => t('Who is online'), 'content' => rokupal_forum_online_block());
        case 'recent':
          return array('subject' => t('Recent topics'), 'content' => rokupal_forum_block_topics('created'));
        case 'active':
          return array('subject' => t('Active topics'), 'content' => rokupal_forum_block_topics('active'));
        case 'stats':
          return array('subject' => t('Board stats'), 'content' => rokupal_forum_block_stats());
        case 'forums':
          return array('subject' => t('Forums'), 'content' => rokupal_forum_block_forums());
        case 'new_topic':
          return array('subject' => t('Participate'), 'content' => rokupal_forum_block_new());
      }
  }
}

function rokupal_forum_block_topics($mode = 'created') {
  if ($mode === 'active') {
    $sql = "SELECT n.nid, n.title, COALESCE(cs.last_comment_timestamp, n.created) AS ts
      FROM {node} n LEFT JOIN {node_comment_statistics} cs ON cs.nid = n.nid
      WHERE n.type = 'forum_topic' AND n.status = 1 ORDER BY ts DESC";
  }
  else {
    $sql = "SELECT n.nid, n.title, n.created AS ts FROM {node} n WHERE n.type = 'forum_topic' AND n.status = 1 ORDER BY n.created DESC";
  }
  $result = db_query_range($sql, 0, 8);
  $items = array();
  while ($row = db_fetch_object($result)) {
    $items[] = l($row->title, 'node/' . $row->nid) . ' <span class="rp-muted">' . format_date($row->ts, 'small') . '</span>';
  }
  return $items ? theme('item_list', $items) : t('No topics yet.');
}

function rokupal_forum_block_stats() {
  $s = rokupal_forum_board_stats();
  return '<ul class="rp-forum-stats">'
    . '<li>' . t('Topics: @n', array('@n' => $s['topics'])) . '</li>'
    . '<li>' . t('Posts: @n', array('@n' => $s['posts'])) . '</li>'
    . '<li>' . t('Members: @n', array('@n' => $s['members'])) . '</li>'
    . '</ul><p>' . l(t('View forums'), 'forum') . ' · ' . l(t('Active'), 'forum/active') . '</p>';
}

function rokupal_forum_block_forums() {
  $vid = variable_get('rokupal_forum_vid', 0);
  if (!$vid) {
    return t('No forums configured.');
  }
  $items = array();
  $result = db_query("SELECT tid, name FROM {term_data} WHERE vid = %d ORDER BY weight, name", $vid);
  while ($row = db_fetch_object($result)) {
    $items[] = l($row->name, 'forum/' . $row->tid);
  }
  return $items ? theme('item_list', $items) : t('No forums.');
}

function rokupal_forum_block_new() {
  $links = array(l(t('Forum index'), 'forum'));
  if (user_access('create forum_topic content')) {
    $links[] = l(t('Post new topic'), 'node/add/forum-topic', array('query' => 'tid=' . (int) $term->tid, 'attributes' => array('class' => 'forum-button')));
  }
  $links[] = l(t('Active topics'), 'forum/active');
  return theme('item_list', $links);
}

/**
 * Place useful forum blocks in sidebar on enable.
 */
function rokupal_forum_setup_blocks() {
  $theme = variable_get('theme_default', 'rokupal');
  $region = 'left';
  // Prefer sidebar_first if region exists in theme
  $blocks = array(
    array('rokupal_forum', 'stats', 0),
    array('rokupal_forum', 'active', 1),
    array('rokupal_forum', 'forums', 2),
  );
  foreach ($blocks as $b) {
    list($module, $delta, $weight) = $b;
    $exists = db_result(db_query("SELECT module FROM {blocks} WHERE module = '%s' AND delta = '%s' AND theme = '%s'", $module, $delta, $theme));
    if ($exists) {
      db_query("UPDATE {blocks} SET status = 1, region = '%s', weight = %d WHERE module = '%s' AND delta = '%s' AND theme = '%s'", $region, $weight, $module, $delta, $theme);
    }
    else {
      db_query("INSERT INTO {blocks} (module, delta, theme, status, weight, region, custom, throttle, visibility, pages, title) VALUES ('%s', '%s', '%s', 1, %d, '%s', 0, 0, 0, '', '')",
        $module, $delta, $theme, $weight, $region);
    }
  }
}

function rokupal_forum_help($path, $arg) {
  if ($path == 'admin/help#rokupal_forum') {
    return t('Forum preset inspired by classic boards (phpBB/vB): index, forums, active topics and sidebar blocks. Disable the module to turn the preset off.');
  }
}


function rokupal_forum_ensure_menu() {
  $exists = db_result(db_query("SELECT mlid FROM {menu_links} WHERE link_path = 'forum' AND menu_name = 'primary-links' LIMIT 1"));
  if ($exists) {
    return;
  }
  $item = array(
    'link_title' => t('Forums'),
    'link_path' => 'forum',
    'menu_name' => 'primary-links',
    'weight' => -18,
    'expanded' => 0,
  );
  if (function_exists('menu_link_save')) {
    menu_link_save($item);
  }
  if (function_exists('menu_cache_clear_all')) {
    menu_cache_clear_all();
  }
}



/**
 * Implements hook_init() — ensure vocabulary/type exist without heavy work every time.
 */
function rokupal_forum_init() {
  $type_ok = FALSE;
  if (db_table_exists('node_type')) {
    $type_ok = (bool) db_result(db_query("SELECT 1 FROM {node_type} WHERE type = 'forum_topic' LIMIT 1"));
  }
  $menu_ok = TRUE;
  if (db_table_exists('menu_router')) {
    $menu_ok = (bool) db_result(db_query("SELECT 1 FROM {menu_router} WHERE path = 'node/add/forum-topic' LIMIT 1"));
  }
  if ($type_ok && $menu_ok && variable_get('rokupal_forum_structure_ready', 0)) {
    return;
  }
  if (function_exists('rokupal_forum_ensure_structure')) {
    rokupal_forum_ensure_structure();
  }
}


/**
 * Implements hook_menu_breadcrumb_alter() if available — skip on D6.
 * Use hook_preprocess_page via theme; here set title only on forum paths.
 */
function rokupal_forum_preprocess_page(&$vars) {
  if (arg(0) != 'forum') {
    return;
  }
  $crumbs = array(l(t('Home'), '<front>'), l(t('Forums'), 'forum'));
  if (arg(1) && arg(1) != 'active' && is_numeric(arg(1))) {
    $term = taxonomy_get_term((int) arg(1));
    if ($term) {
      $crumbs[] = check_plain($term->name);
    }
  }
  elseif (arg(1) == 'active') {
    $crumbs[] = t('Active topics');
  }
  $vars['breadcrumb'] = theme('breadcrumb', $crumbs);
}


/**
 * Who is online — sessions active in the last 15 minutes (lightweight).
 */
function rokupal_forum_online_block() {
  $window = (int) variable_get('rokupal_online_window', 900);
  $since = time() - $window;
  $items = array();
  $n_anon = 0;
  if (db_table_exists('sessions')) {
    $result = db_query("SELECT s.uid, u.name FROM {sessions} s LEFT JOIN {users} u ON u.uid = s.uid WHERE s.timestamp >= %d ORDER BY s.timestamp DESC LIMIT 50", $since);
    $seen = array();
    while ($row = db_fetch_object($result)) {
      $uid = (int) $row->uid;
      if ($uid <= 0) {
        $n_anon++;
        continue;
      }
      if (isset($seen[$uid])) {
        continue;
      }
      $seen[$uid] = TRUE;
      $items[] = theme('username', (object) array('uid' => $uid, 'name' => $row->name));
    }
  }
  $out = '';
  if ($items) {
    $out .= theme('item_list', $items);
  }
  $out .= '<p class="rp-muted">' . t('@m members, @a guests (last @min min)', array(
    '@m' => count($items),
    '@a' => $n_anon,
    '@min' => (int) ($window / 60),
  )) . '</p>';
  return $out;
}


/**
 * Force forum category on forum topics; pass ?tid= for preselect.
 */
function rokupal_forum_form_alter(&$form, $form_state, $form_id) {
  if ($form_id != 'forum_topic_node_form') {
    return;
  }
  $vid = (int) variable_get('rokupal_forum_vid', 0);
  if (!$vid) {
    if (function_exists('rokupal_forum_ensure_structure')) {
      rokupal_forum_ensure_structure();
      $vid = (int) variable_get('rokupal_forum_vid', 0);
    }
  }
  if ($vid && isset($form['taxonomy'][$vid])) {
    $form['taxonomy'][$vid]['#required'] = TRUE;
    $form['taxonomy'][$vid]['#title'] = t('Forum');
    $form['taxonomy'][$vid]['#description'] = t('Category for this topic (not a blog category).');
    if (!empty($_GET['tid']) && is_numeric($_GET['tid'])) {
      $form['taxonomy'][$vid]['#default_value'] = array((int) $_GET['tid']);
    }
  }
  $form['title']['#title'] = t('Subject');
}


/**
 * Simple UI to add forum categories (taxonomy terms under Forums vocab).
 */
function rokupal_forum_manage_page() {
  if (function_exists('rokupal_forum_ensure_structure')) {
    rokupal_forum_ensure_structure();
  }
  $vid = (int) variable_get('rokupal_forum_vid', 0);
  if (!$vid) {
    return t('Forum vocabulary is not ready. Try re-enabling the RokuPal Forum module.');
  }

  // Handle add.
  if ($_SERVER['REQUEST_METHOD'] === 'POST' && !empty($_POST['rokupal_forum_add'])) {
    if (function_exists('drupal_valid_token') && !drupal_valid_token($_POST['token'], 'rokupal_forum_manage')) {
      drupal_set_message(t('Invalid token'), 'error');
    }
    else {
      $name = trim($_POST['name']);
      $desc = trim($_POST['description']);
      $parent = isset($_POST['parent']) ? (int) $_POST['parent'] : 0;
      if ($name !== '') {
        $term = array(
          'vid' => $vid,
          'name' => $name,
          'description' => $desc,
          'parent' => $parent ? array($parent) : array(0),
          'weight' => 0,
        );
        taxonomy_save_term($term);
        drupal_set_message(t('Forum category @n created.', array('@n' => $name)));
        drupal_goto('forum/manage');
      }
    }
  }

  $token = function_exists('drupal_get_token') ? drupal_get_token('rokupal_forum_manage') : '';
  $tree = taxonomy_get_tree($vid);
  $rows = array();
  foreach ($tree as $term) {
    $indent = str_repeat('— ', (int) $term->depth);
    $rows[] = array(
      $indent . check_plain($term->name),
      check_plain($term->description),
      l(t('View'), 'forum/' . $term->tid) . ' · ' . l(t('Edit'), 'admin/content/taxonomy/edit/term/' . $term->tid),
    );
  }
  if (!$rows) {
    $rows[] = array(array('data' => t('No categories yet.'), 'colspan' => 3));
  }

  $out = '<div class="forum-vbulletin">';
  $out .= '<div class="forum-vbulletin-header">' . t('Manage forum categories') . '</div>';
  $out .= theme('table', array(t('Name'), t('Description'), t('Ops')), $rows, array('class' => 'forum-table'));

  $parent_opts = '<option value="0">' . t('— top level —') . '</option>';
  foreach ($tree as $term) {
    $parent_opts .= '<option value="' . (int) $term->tid . '">' . str_repeat('— ', (int) $term->depth) . check_plain($term->name) . '</option>';
  }

  $out .= '<h3>' . t('Add category / subcategory') . '</h3>';
  $out .= '<form method="post" action="' . url('forum/manage') . '" class="rp-forum-manage-form">';
  $out .= '<input type="hidden" name="token" value="' . check_plain($token) . '" />';
  $out .= '<p><label>' . t('Name') . ' <input type="text" name="name" size="40" required="required" /></label></p>';
  $out .= '<p><label>' . t('Description') . ' <input type="text" name="description" size="60" /></label></p>';
  $out .= '<p><label>' . t('Parent') . ' <select name="parent">' . $parent_opts . '</select></label></p>';
  $out .= '<p><button type="submit" name="rokupal_forum_add" value="1" class="form-submit">' . t('Add forum') . '</button></p>';
  $out .= '</form>';
  $out .= '<p>' . l(t('« Back to forums'), 'forum') . '</p>';
  $out .= '</div>';
  return $out;
}

function rokupal_forum_ensure_structure() {
  // 1) Content type — check DB directly (node_get_types static cache can lie).
  $type_exists = FALSE;
  if (db_table_exists('node_type')) {
    $type_exists = (bool) db_result(db_query("SELECT 1 FROM {node_type} WHERE type = 'forum_topic' LIMIT 1"));
  }
  if (!$type_exists) {
    $obj = (object) array(
      'type' => 'forum_topic',
      'name' => 'Forum topic',
      'module' => 'node',
      'description' => 'Tema de discusión en un foro.',
      'has_title' => 1,
      'title_label' => 'Subject',
      'has_body' => 1,
      'body_label' => 'Body',
      'min_word_count' => 0,
      'custom' => 1,
      'modified' => 1,
      'locked' => 0,
      'help' => '',
      'orig_type' => 'forum_topic',
    );
    if (function_exists('node_type_save')) {
      node_type_save($obj);
    }
    else {
      db_query("INSERT INTO {node_type} (type, name, module, has_title, title_label, has_body, body_label, description, help, min_word_count, custom, modified, locked, orig_type) VALUES ('forum_topic', 'Forum topic', 'node', 1, 'Subject', 1, 'Body', 'Tema de discusión en un foro.', '', 0, 1, 1, 0, 'forum_topic')");
    }
    variable_set('node_options_forum_topic', array('status'));
    variable_set('comment_forum_topic', 2);
    if (function_exists('node_types_rebuild')) {
      node_types_rebuild();
    }
    // Create content list is built from MENU, not from DB alone.
    if (function_exists('menu_rebuild')) {
      menu_rebuild();
    }
  }

  // 2) Vocabulary Forums → only forum_topic
  $vid = (int) variable_get('rokupal_forum_vid', 0);
  $vocab = ($vid && function_exists('taxonomy_vocabulary_load')) ? taxonomy_vocabulary_load($vid) : FALSE;
  if (!$vocab) {
    $found = (int) db_result(db_query("SELECT vid FROM {vocabulary} WHERE name = 'Forums' LIMIT 1"));
    if ($found) {
      $vid = $found;
      variable_set('rokupal_forum_vid', $vid);
      $vocab = taxonomy_vocabulary_load($vid);
    }
  }
  if (!$vocab && function_exists('taxonomy_save_vocabulary')) {
    $edit = array(
      'name' => 'Forums',
      'description' => 'Categorías de foro.',
      'help' => 'Elegí el foro donde publicar el tema.',
      'tags' => 0,
      'multiple' => 0,
      'required' => 1,
      'hierarchy' => 1,
      'relations' => 0,
      'module' => 'taxonomy',
      'weight' => -5,
      'nodes' => array('forum_topic' => 1),
    );
    taxonomy_save_vocabulary($edit);
    if (!empty($edit['vid'])) {
      $vid = (int) $edit['vid'];
      variable_set('rokupal_forum_vid', $vid);
    }
  }
  elseif ($vocab) {
    $vid = (int) $vocab->vid;
    variable_set('rokupal_forum_vid', $vid);
    db_query("DELETE FROM {vocabulary_node_types} WHERE vid = %d", $vid);
    db_query("INSERT INTO {vocabulary_node_types} (vid, type) VALUES (%d, 'forum_topic')", $vid);
    db_query("UPDATE {vocabulary} SET required = 1, hierarchy = 1, multiple = 0, tags = 0 WHERE vid = %d", $vid);
  }

  // 3) Default terms
  if (!empty($vid) && function_exists('taxonomy_get_tree')) {
    $tree = taxonomy_get_tree($vid);
    if (empty($tree) && function_exists('taxonomy_save_term')) {
      foreach (array(
        array('General discussion', 'Talk about anything.'),
        array('News & announcements', 'Official news.'),
        array('Help & support', 'Questions and troubleshooting.'),
      ) as $weight => $pair) {
        taxonomy_save_term(array(
          'vid' => $vid,
          'name' => $pair[0],
          'description' => $pair[1],
          'weight' => $weight,
        ));
      }
    }
  }

  // 4) Permissions (authenticated rid=2, admin rid=3)
  $grant = array(
    2 => array('create forum_topic content', 'edit own forum_topic content', 'delete own forum_topic content'),
    3 => array('create forum_topic content', 'edit any forum_topic content', 'delete any forum_topic content', 'edit own forum_topic content', 'delete own forum_topic content'),
  );
  foreach ($grant as $rid => $need) {
    $row = db_fetch_object(db_query("SELECT perm FROM {permission} WHERE rid = %d", $rid));
    if ($row && $row->perm !== '') {
      $perms = array_map('trim', explode(',', $row->perm));
      // D6 often uses ", " join
      $perms = array_filter(array_map('trim', preg_split('/,\s*/', $row->perm)));
      $changed = FALSE;
      foreach ($need as $p) {
        if (!in_array($p, $perms)) {
          $perms[] = $p;
          $changed = TRUE;
        }
      }
      if ($changed) {
        db_query("UPDATE {permission} SET perm = '%s' WHERE rid = %d", implode(', ', $perms), $rid);
      }
    }
    else {
      // role may lack a permission row
      $exists = db_result(db_query("SELECT COUNT(*) FROM {permission} WHERE rid = %d", $rid));
      if ($exists) {
        db_query("UPDATE {permission} SET perm = '%s' WHERE rid = %d", implode(', ', $need), $rid);
      }
      else {
        db_query("INSERT INTO {permission} (rid, perm) VALUES (%d, '%s')", $rid, implode(', ', $need));
      }
    }
  }

  // 5) Ensure menu router has node/add/forum-topic
  if (function_exists('menu_rebuild') && !variable_get('rokupal_forum_menu_ok', 0)) {
    menu_rebuild();
    variable_set('rokupal_forum_menu_ok', 1);
  }
  // If type was just created we already rebuilt; if menu still missing path, rebuild once more.
  if (db_table_exists('menu_router')) {
    $path_ok = db_result(db_query("SELECT path FROM {menu_router} WHERE path = 'node/add/forum-topic' LIMIT 1"));
    if (!$path_ok && function_exists('menu_rebuild')) {
      menu_rebuild();
    }
  }

  variable_set('rokupal_forum_structure_ready', 1);
  if (function_exists('cache_clear_all')) {
    cache_clear_all();
  }
}

/** Alias for older enable() calls. */
function rokupal_forum_ensure() {
  rokupal_forum_ensure_structure();
}


