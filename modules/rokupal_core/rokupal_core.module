/**
 * Implementation of hook_theme().
 */
function rokupal_core_theme() {
  return array(
    'status_report' => array(
      'arguments' => array('requirements' => NULL),
    ),
  );
}

/**
 * PHP 8-safe status report.
 */
function rokupal_core_status_report($requirements) {
  if (!defined('REQUIREMENT_INFO')) {
    define('REQUIREMENT_INFO', -1);
    define('REQUIREMENT_OK', 0);
    define('REQUIREMENT_WARNING', 1);
    define('REQUIREMENT_ERROR', 2);
  }
  $severities = array(
    REQUIREMENT_INFO => 'info',
    REQUIREMENT_OK => 'ok',
    REQUIREMENT_WARNING => 'warning',
    REQUIREMENT_ERROR => 'error',
  );
  $output = '<table class="system-status-report">';
  if (!is_array($requirements)) {
    $requirements = array();
  }
  foreach ($requirements as $requirement) {
    if (!is_array($requirement)) {
      continue;
    }
    $severity = isset($requirement['severity']) ? (int) $requirement['severity'] : 0;
    $class = isset($severities[$severity]) ? $severities[$severity] : 'info';
    $title = isset($requirement['title']) ? $requirement['title'] : '';
    $value = isset($requirement['value']) ? $requirement['value'] : '';
    $desc = isset($requirement['description']) ? $requirement['description'] : '';
    if ($desc !== '') {
      $output .= '<tr class="' . $class . ' merge-down"><th>' . $title . '</th><td>' . $value . '</td></tr>';
      $output .= '<tr class="' . $class . ' merge-up"><td colspan="2">' . $desc . '</td></tr>';
    }
    else {
      $output .= '<tr class="' . $class . '"><th>' . $title . '</th><td>' . $value . '</td></tr>';
    }
  }
  $output .= '</table>';
  return $output;
}


/**
 * Implements hook_requirements() — warn about legacy md5 password hashes.
 */
function rokupal_core_requirements($phase) {
  $reqs = array();
  if ($phase == 'runtime' && function_exists('db_query')) {
    $legacy = 0;
    $total = 0;
    try {
      $result = db_query("SELECT pass FROM {users} WHERE uid > 0 AND status = 1");
      while ($row = db_fetch_object($result)) {
        $total++;
        $hash = isset($row->pass) ? (string) $row->pass : '';
        if (strlen($hash) === 32 && ctype_xdigit($hash)) {
          $legacy++;
        }
      }
    }
    catch (Exception $e) {
      $legacy = -1;
    }
    if ($legacy > 0) {
      $reqs['rokupal_passwords'] = array(
        'title' => t('Password hashing'),
        'value' => t('@n account(s) still use legacy md5 hashes', array('@n' => $legacy)),
        'description' => t('They will upgrade to bcrypt automatically the next time each user logs in.'),
        'severity' => REQUIREMENT_WARNING,
      );
    }
    elseif ($legacy === 0 && $total > 0) {
      $reqs['rokupal_passwords'] = array(
        'title' => t('Password hashing'),
        'value' => t('All active accounts use modern password_hash (bcrypt)'),
        'severity' => REQUIREMENT_OK,
      );
    }
  }
  return $reqs;
}



/**
 * BC: admin bar moved to rokupal_admin_bar module.
 */
function rokupal_core_admin_bar_render() {
  if (function_exists('rokupal_admin_bar_render')) {
    return rokupal_admin_bar_render();
  }
  return '';
}

function rokupal_core_admin_bar_enabled() {
  if (function_exists('rokupal_admin_bar_enabled')) {
    return rokupal_admin_bar_enabled();
  }
  return FALSE;
}



/**
 * Implements hook_enable().
 */
function rokupal_core_enable() {
  // Allow block-level caching (modules declare cache modes on their blocks).
  variable_set('block_cache', 1);

  // Aggregation often breaks stylesheet paths on XAMPP subdirectory installs.
  variable_set('preprocess_css', 0);
  variable_set('preprocess_js', 0);
}


/**
 * Harden session cookie flags when the request is HTTPS.
 */
function rokupal_core_secure_session_cookie() {
  static $done = FALSE;
  if ($done) {
    return;
  }
  $done = TRUE;
  $https = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off')
    || (isset($_SERVER['SERVER_PORT']) && (string) $_SERVER['SERVER_PORT'] === '443')
    || (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) && strtolower($_SERVER['HTTP_X_FORWARDED_PROTO']) === 'https');
  if ($https) {
    @ini_set('session.cookie_secure', '1');
  }
  // Prefer HttpOnly / SameSite even if settings.php omitted them.
  @ini_set('session.cookie_httponly', '1');
  // PHP 7.3+ supports SameSite via ini; ignore failures on older builds.
  @ini_set('session.cookie_samesite', 'Lax');
  @ini_set('session.use_only_cookies', '1');
  @ini_set('session.use_trans_sid', '0');
}


/**
 * Optional gzip page output (enable: variable_set('rokupal_gzip', 1)).
 * Inspired by lightweight forum stacks; off by default for XAMPP simplicity.
 */
function rokupal_core_gzip_start() {
  if (!variable_get('rokupal_gzip', 0)) {
    return;
  }
  if (headers_sent()) {
    return;
  }
  if (empty($_SERVER['HTTP_ACCEPT_ENCODING']) || strpos($_SERVER['HTTP_ACCEPT_ENCODING'], 'gzip') === FALSE) {
    return;
  }
  if (!function_exists('ob_gzhandler') || !extension_loaded('zlib')) {
    return;
  }
  // Avoid double compression.
  if (ini_get('zlib.output_compression')) {
    return;
  }
  ob_start('ob_gzhandler');
}

